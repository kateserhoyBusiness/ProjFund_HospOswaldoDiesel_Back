# Front-end permitido (origens separadas por vírgula, sem barra final).
CORS_ORIGIN=http://localhost:5173

# Configure um segredo aleatório de pelo menos 32 caracteres antes de produção.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
NODE_ENV=development
PORT=3000

# Banco opcional para desenvolvimento local; em produção é obrigatório.
DATABASE_URL=
# Para conexão por campos, deixe DATABASE_URL vazio e preencha as variáveis DB_*.
DB_HOST=
DB_PORT=5432
DB_NAME=sgep_hospital_experience
DB_USER=
DB_PASSWORD=
DB_SSL=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
